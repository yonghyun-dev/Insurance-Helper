# ============================================================
# 추론 LLM provider (Sprint 16 1a — 국내 전용)
# ============================================================
# [하드 제약] 제품 추론은 국내 모델(Upstage Solar)만. OpenAI 폴백 없음.
#   upstage(기본) → UPSTAGE_API_KEY + UPSTAGE_BASE_URL + SOLAR_MODEL 사용
#   openai        → 오프라인 dev/eval 전용 (OPENAI_API_KEY + LLM_MODEL). 제품 경로 비권장.
LLM_PROVIDER=upstage
UPSTAGE_API_KEY=
UPSTAGE_BASE_URL=https://api.upstage.ai/v1
SOLAR_MODEL=solar-pro2

# 임베딩 provider (Sprint 16 1b — 국내 전용, query/passage 분리, 4096-d)
#   upstage(기본) → Upstage solar-embedding (embedding-query / embedding-passage). OpenAI 폴백 없음.
#   openai        → 오프라인 dev/eval 전용 (EMBEDDING_MODEL).
EMBEDDING_PROVIDER=upstage
UPSTAGE_EMBEDDING_QUERY_MODEL=embedding-query
UPSTAGE_EMBEDDING_PASSAGE_MODEL=embedding-passage

# OpenAI (provider=openai 일 때만. OCR(1c 전) 잔존 경로 공용)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# 저장소 경로 (상대 경로는 현재 작업 디렉터리 기준)
SQLITE_DB_PATH=./app.db
CHROMA_DB_PATH=./chroma_db
RAW_DATA_PATH=./data/raw

# 세션 TTL (Sprint 2부터 사용)
SESSION_TTL_SECONDS=1800

# CORS (Sprint 3부터 사용. 콤마 구분 문자열 또는 JSON 배열)
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# Sprint 4 — GraphRAG (Neo4j Docker)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme-please

# Retrieval 모드: vector | graph | hybrid (기본 vector — 회귀 0 보장)
RAG_MODE=vector

# ReAct loop on/off (assessment 모드에서만 적용. 기본 off)
RAG_REACT=false

# 로깅
LOG_LEVEL=INFO

# ============================================================
# Sprint 8+ — 운영/인증/외부연동 (값은 .env 에만)
# ============================================================
# 벡터 스토어: 빈 값이면 DATABASE_URL 자동 감지 (postgresql → pgvector / 그 외 → chroma)
VECTOR_STORE=
DATABASE_URL=
# Agent 백엔드: agentrunner(기본) | langgraph
RAG_BACKEND=agentrunner
# JWT 인증 (Sprint 14 — 비어있으면 인증 endpoint 401)
JWT_SECRET_KEY=
# 외부 어댑터 backend: dummy(기본) | real
MYDATA_BACKEND=dummy
HEALTH_DATA_BACKEND=dummy
# OCR 엔진: openai(기본) | upstage
OCR_BACKEND=openai

# ============================================================
# 챔피언 대회 LLM 인프라 (2026-06-14) — 상세: docs/infra/llm-access.md
# ============================================================
# AWS Bedrock (Converse API + Bearer. 토큰 만료 2026-07-31)
BEDROCK_API_KEY=
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-haiku-4-5-20251001-v1:0
# Upstage Solar — 추론 provider 섹션(상단 UPSTAGE_API_KEY/UPSTAGE_BASE_URL/SOLAR_MODEL) 참조
# LG EXAONE (FriendliAI dedicated, OpenAI 호환, 추론형 — max_tokens≥512). Sprint 16 미사용(Solar 단일).
EXAONE_API_KEY=
EXAONE_ENDPOINT_ID=
# SKT A.X K1 (미발급)
AX_K1_API_KEY=
# GPU 서버 (SSH)
GPU_SERVER_HOST=
GPU_SERVER_USER=
GPU_SERVER_PASSWORD=
